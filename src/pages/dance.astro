---
import Layout from '../layouts/Layout.astro';
import danceEvents from '../data/dance_events.json';
---

<Layout
  title="Dance & Baton Twirling | Zimeng (Amy) Yan"
  description="Discover the competitive baton twirling and dance journey of Zimeng (Amy) Yan — National Champion, 7-time State Champion, with over a decade on stage."
>
  <!-- Header Banner -->
  <section class="pt-16 pb-12 md:pt-24 md:pb-16 bg-gradient-to-b from-stone-100/90 to-stone-50 border-b border-stone-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-rose-100/80 border border-rose-200 text-rose-900 text-xs font-mono uppercase tracking-wider mb-4">
          Competitive Performance Art
        </div>
        <h1 class="text-4xl sm:text-5xl font-serif font-bold text-stone-900 tracking-tight leading-tight">
          Where Passion Meets the Beat
        </h1>
        <p class="mt-4 text-base sm:text-lg text-stone-600 leading-relaxed font-sans">
          "Since age five, I have chased flight with my feet, spun a baton across the sky, and felt the stands erupt around me!"
        </p>

        <!-- Achievements Badge Strip -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-8 pt-6 border-t border-stone-200 text-left">
          <div>
            <span class="block text-2xl sm:text-3xl font-serif font-bold text-stone-900">1</span>
            <span class="block text-xs font-mono text-stone-500 uppercase tracking-tight">National Championship</span>
          </div>
          <div>
            <span class="block text-2xl sm:text-3xl font-serif font-bold text-stone-900">7</span>
            <span class="block text-xs font-mono text-stone-500 uppercase tracking-tight">State Championships</span>
          </div>
          <div>
            <span class="block text-2xl sm:text-3xl font-serif font-bold text-stone-900">25+</span>
            <span class="block text-xs font-mono text-stone-500 uppercase tracking-tight">Local Titles</span>
          </div>
          <div>
            <span class="block text-2xl sm:text-3xl font-serif font-bold text-stone-900">585</span>
            <span class="block text-xs font-mono text-stone-500 uppercase tracking-tight">Consecutive Days Streak</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Narrative Spotlight: Discipline & Flight -->
  <section class="py-12 md:py-16 bg-white border-b border-stone-200/70">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="p-6 rounded-2xl bg-stone-50 border border-stone-200/80">
          <span class="text-xs font-mono text-amber-700 font-bold block mb-2">01 / DEDICATION</span>
          <h2 class="font-serif text-xl font-bold text-stone-900 mb-2">585 Consecutive Days</h2>
          <p class="text-xs text-stone-600 leading-relaxed">
            Earning a coveted spot on the competitive team demanded unyielding discipline. Practicing rain or shine for 585 straight days forged resilience and neuromuscular precision.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-stone-50 border border-stone-200/80">
          <span class="text-xs font-mono text-amber-700 font-bold block mb-2">02 / EXCELLENCE</span>
          <h2 class="font-serif text-xl font-bold text-stone-900 mb-2">Solo & Duo Championships</h2>
          <p class="text-xs text-stone-600 leading-relaxed">
            Capturing state titles in both individual solo routines and synchronized duo choreography, balancing individual virtuosity with collaborative harmony.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-stone-50 border border-stone-200/80">
          <span class="text-xs font-mono text-amber-700 font-bold block mb-2">03 / STAGE PRESENCE</span>
          <h2 class="font-serif text-xl font-bold text-stone-900 mb-2">Composure Under Pressure</h2>
          <p class="text-xs text-stone-600 leading-relaxed">
            Performing high-risk aerial releases in front of thousands teaches emotional regulation and split-second focus — qualities that directly translate to emergency medical practice.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Performance Timeline & Gallery -->
  <section class="py-16 md:py-24 bg-stone-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-12">
        <span class="text-xs font-mono uppercase tracking-widest text-stone-500 font-semibold block mb-2">
          Performance Chronicles
        </span>
        <h2 class="text-3xl sm:text-4xl font-serif font-bold text-stone-900 tracking-tight">
          Stage & Championship Showcase
        </h2>
        <p class="mt-2 text-stone-600 text-sm sm:text-base">
          Click any performance photo below to open in full resolution.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {danceEvents.map((event) => (
          <div
            class="dance-card group rounded-2xl overflow-hidden bg-white border border-stone-200 hover:border-stone-900 hover:shadow-xl transition-all duration-300 cursor-pointer flex flex-col"
            data-year={event.year}
            data-image={event.coverImageUrl}
          >
            <div class="relative aspect-[3/4] overflow-hidden bg-stone-100">
              <img
                src={event.coverImageUrl}
                alt={`Amy dance performance ${event.year}`}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-stone-950/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
                <span class="px-3.5 py-1.5 rounded-full bg-white/95 text-stone-900 text-xs font-semibold shadow-md">
                  Expand Photo ↗
                </span>
              </div>
              <div class="absolute top-3 left-3 px-2.5 py-1 rounded-md text-xs font-mono font-bold bg-stone-900/80 text-stone-50 backdrop-blur-xs">
                {event.year}
              </div>
            </div>

            <div class="p-4 flex items-center justify-between">
              <div>
                <h3 class="font-serif font-bold text-stone-900 text-sm group-hover:text-amber-800 transition-colors">
                  Performance Season {event.year}
                </h3>
                <p class="text-[11px] font-mono text-stone-500">Baton & Stage Showcase</p>
              </div>
              <span class="text-stone-400 group-hover:text-stone-900 transition-colors">↗</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Dance Lightbox Modal -->
  <dialog
    id="dance-modal"
    class="backdrop:bg-stone-950/80 backdrop:backdrop-blur-xs p-0 rounded-2xl shadow-2xl border border-stone-200 bg-stone-950 max-w-4xl w-[92vw] overflow-hidden m-auto"
  >
    <div class="relative flex flex-col items-center justify-center p-4">
      <button
        id="close-dance-modal"
        type="button"
        class="absolute top-4 right-4 z-10 px-3.5 py-1.5 rounded-full bg-stone-800 text-white text-xs font-mono hover:bg-stone-700 transition-colors"
      >
        Close ✕
      </button>
      <img
        id="dance-modal-img"
        src=""
        alt=""
        class="max-h-[82vh] w-auto max-w-full object-contain rounded-lg"
      />
      <div class="mt-3 text-center">
        <span id="dance-modal-year" class="text-xs font-mono text-amber-400 font-bold uppercase tracking-widest"></span>
      </div>
    </div>
  </dialog>
</Layout>

<script>
  const modal = document.getElementById('dance-modal') as HTMLDialogElement | null;
  const modalImg = document.getElementById('dance-modal-img') as HTMLImageElement | null;
  const modalYear = document.getElementById('dance-modal-year');
  const closeBtn = document.getElementById('close-dance-modal');
  const cards = document.querySelectorAll<HTMLElement>('.dance-card');

  cards.forEach((card) => {
    card.addEventListener('click', () => {
      const img = card.dataset.image || '';
      const year = card.dataset.year || '';
      if (modalImg) modalImg.src = img;
      if (modalYear) modalYear.textContent = `Performance Showcase • ${year}`;
      modal?.showModal();
    });
  });

  closeBtn?.addEventListener('click', () => modal?.close());
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) modal.close();
  });
</script>
