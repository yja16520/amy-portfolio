---
import Layout from '../layouts/Layout.astro';
import artworks from '../data/artworks.json';

const mediums = ['All', 'Oil', 'Colored pencils', 'Black and white pencil'];
const totalCount = artworks.length;
---

<Layout
  title="Visual Art Studio | Zimeng (Amy) Yan"
  description="Explore the fine art portfolio of Zimeng (Amy) Yan, featuring photorealistic oil paintings, colored pencil illustrations, and charcoal still life studies."
>
  <!-- Header Banner -->
  <section class="pt-16 pb-12 md:pt-24 md:pb-16 bg-gradient-to-b from-stone-100/80 to-stone-50 border-b border-stone-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-100/80 border border-amber-200 text-amber-900 text-xs font-mono uppercase tracking-wider mb-4">
          Visual Arts & Realism
        </div>
        <h1 class="text-4xl sm:text-5xl font-serif font-bold text-stone-900 tracking-tight leading-tight">
          Observation, Light & Form
        </h1>
        <p class="mt-4 text-base sm:text-lg text-stone-600 leading-relaxed">
          Over a decade of weekly studio practice exploring how light bends through glass, the subtle warmth of textures, and the delicate nature of photorealism across oil, colored pencils, and graphite.
        </p>
        <div class="flex items-center gap-6 mt-6 pt-4 border-t border-stone-200 text-xs font-mono text-stone-500">
          <span>{totalCount} Curated Pieces</span>
          <span>•</span>
          <span>Oil on Canvas & Mixed Media</span>
          <span>•</span>
          <span>2 Local Art Awards</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Controls: Filter & Search -->
  <section class="sticky top-20 z-30 bg-stone-50/90 backdrop-blur-md border-b border-stone-200/80 py-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
      <!-- Medium Filter Buttons -->
      <div class="flex flex-wrap items-center gap-2" id="medium-filters">
        {mediums.map((m) => (
          <button
            type="button"
            data-filter={m}
            class={`filter-btn px-4 py-1.5 rounded-full text-xs font-medium transition-all ${
              m === 'All'
                ? 'bg-stone-900 text-stone-50 shadow-xs active'
                : 'bg-white text-stone-700 border border-stone-300 hover:border-stone-900'
            }`}
          >
            {m}
          </button>
        ))}
      </div>

      <!-- Real-time Search Input -->
      <div class="relative w-full md:w-72">
        <input
          type="text"
          id="art-search"
          placeholder="Search artwork by title or keyword..."
          class="w-full px-4 py-2 pl-9 rounded-full bg-white border border-stone-300 text-xs text-stone-900 placeholder:text-stone-400 focus:outline-hidden focus:ring-2 focus:ring-amber-600 focus:border-amber-600 transition-all shadow-xs"
        />
        <svg class="w-4 h-4 text-stone-400 absolute left-3 top-2.5 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>
    </div>
  </section>

  <!-- Artwork Gallery Grid -->
  <section class="py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div id="art-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {artworks.map((art) => (
          <article
            class="art-card group rounded-2xl overflow-hidden bg-white border border-stone-200/90 hover:border-stone-900 hover:shadow-xl transition-all duration-300 flex flex-col cursor-pointer"
            data-id={art.id}
            data-medium={art.type}
            data-title={art.title.toLowerCase()}
            data-desc={art.description.toLowerCase()}
            data-year={art.year}
            data-image={art.imageUrl}
            data-materials={art.materials || ''}
          >
            <!-- Image Thumbnail -->
            <div class="relative aspect-[4/5] overflow-hidden bg-stone-100">
              <img
                src={art.imageUrl}
                alt={art.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-stone-950/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
                <span class="px-4 py-2 rounded-full bg-white/95 text-stone-900 text-xs font-semibold shadow-md transform translate-y-2 group-hover:translate-y-0 transition-transform">
                  View Full Study & Rationale →
                </span>
              </div>
              <div class="absolute top-3 left-3 px-2.5 py-1 rounded-md text-[11px] font-mono font-medium bg-stone-900/80 text-stone-50 backdrop-blur-xs">
                {art.type}
              </div>
              <div class="absolute top-3 right-3 px-2 py-0.5 rounded text-[11px] font-mono bg-white/90 text-stone-700 shadow-xs">
                {art.year}
              </div>
            </div>

            <!-- Card Content -->
            <div class="p-6 flex-grow flex flex-col justify-between">
              <div>
                <h2 class="font-serif text-xl font-bold text-stone-900 group-hover:text-amber-800 transition-colors">
                  {art.title}
                </h2>
                <p class="text-xs text-stone-600 mt-2 line-clamp-3 leading-relaxed">
                  {art.description}
                </p>
              </div>
              <div class="mt-4 pt-3 border-t border-stone-100 text-xs font-mono text-amber-800 flex items-center justify-between">
                <span>Expand Detail</span>
                <span class="group-hover:translate-x-1 transition-transform">↗</span>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- Empty State When Search Yields Nothing -->
      <div id="no-results" class="hidden text-center py-20">
        <p class="font-serif text-2xl text-stone-800 mb-2">No artworks matched your search</p>
        <p class="text-xs font-mono text-stone-500">Try adjusting your filters or search keywords</p>
      </div>
    </div>
  </section>

  <!-- Accessible Modal Dialog for Artwork Lightbox -->
  <dialog
    id="art-modal"
    class="backdrop:bg-stone-950/70 backdrop:backdrop-blur-xs p-0 rounded-2xl shadow-2xl border border-stone-200 bg-white max-w-4xl w-[92vw] overflow-hidden m-auto"
  >
    <div class="flex flex-col md:flex-row max-h-[88vh]">
      <!-- Modal Image View -->
      <div class="md:w-3/5 bg-stone-950 flex items-center justify-center p-4 overflow-hidden relative">
        <img
          id="modal-image"
          src=""
          alt=""
          class="max-h-[50vh] md:max-h-[82vh] w-auto max-w-full object-contain rounded-md"
        />
        <button
          id="close-modal-top"
          type="button"
          aria-label="Close dialog"
          class="md:hidden absolute top-4 right-4 p-2 rounded-full bg-stone-800/80 text-white"
        >
          ✕
        </button>
      </div>

      <!-- Modal Information Column -->
      <div class="md:w-2/5 p-6 md:p-8 flex flex-col justify-between overflow-y-auto bg-stone-50">
        <div>
          <div class="flex items-center justify-between pb-4 border-b border-stone-200">
            <span id="modal-medium" class="text-xs font-mono px-2.5 py-1 rounded-md bg-stone-900 text-stone-50 uppercase tracking-wider"></span>
            <span id="modal-year" class="text-xs font-mono text-stone-500 font-semibold"></span>
          </div>

          <h2 id="modal-title" class="text-2xl sm:text-3xl font-serif font-bold text-stone-900 mt-4 leading-tight"></h2>

          <div class="mt-4 pt-4 border-t border-stone-200/80 space-y-3">
            <h3 class="text-xs font-mono uppercase tracking-widest text-amber-800 font-bold">Artist's Reflection</h3>
            <p id="modal-desc" class="text-sm text-stone-700 leading-relaxed whitespace-pre-line"></p>
          </div>

          <div id="modal-materials-box" class="mt-4 p-3 rounded-lg bg-white border border-stone-200 hidden">
            <span class="text-xs font-mono text-stone-500 block">Materials & Techniques:</span>
            <span id="modal-materials" class="text-xs text-stone-800 font-medium"></span>
          </div>
        </div>

        <div class="pt-6 mt-6 border-t border-stone-200 flex items-center justify-between">
          <span class="text-xs font-mono text-stone-400">Zimeng (Amy) Yan Studio</span>
          <button
            id="close-modal-btn"
            type="button"
            class="px-5 py-2 rounded-full text-xs font-semibold bg-stone-900 text-stone-50 hover:bg-stone-800 transition-colors"
          >
            Close View ✕
          </button>
        </div>
      </div>
    </div>
  </dialog>
</Layout>

<script>
  // Interactive Filtering & Search Logic
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const searchInput = document.getElementById('art-search') as HTMLInputElement | null;
  const cards = document.querySelectorAll<HTMLElement>('.art-card');
  const noResults = document.getElementById('no-results');

  let currentFilter = 'All';
  let searchQuery = '';

  function applyFilters() {
    let visibleCount = 0;
    cards.forEach((card) => {
      const medium = card.dataset.medium || '';
      const title = card.dataset.title || '';
      const desc = card.dataset.desc || '';

      const matchesMedium = currentFilter === 'All' || medium === currentFilter;
      const matchesSearch = !searchQuery || title.includes(searchQuery) || desc.includes(searchQuery);

      if (matchesMedium && matchesSearch) {
        card.classList.remove('hidden');
        visibleCount++;
      } else {
        card.classList.add('hidden');
      }
    });

    if (noResults) {
      if (visibleCount === 0) {
        noResults.classList.remove('hidden');
      } else {
        noResults.classList.add('hidden');
      }
    }
  }

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => {
        b.classList.remove('bg-stone-900', 'text-stone-50', 'shadow-xs', 'active');
        b.classList.add('bg-white', 'text-stone-700', 'border', 'border-stone-300');
      });
      btn.classList.add('bg-stone-900', 'text-stone-50', 'shadow-xs', 'active');
      btn.classList.remove('bg-white', 'text-stone-700', 'border', 'border-stone-300');

      currentFilter = btn.dataset.filter || 'All';
      applyFilters();
    });
  });

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
      applyFilters();
    });
  }

  // Lightbox Modal Logic
  const modal = document.getElementById('art-modal') as HTMLDialogElement | null;
  const modalImage = document.getElementById('modal-image') as HTMLImageElement | null;
  const modalTitle = document.getElementById('modal-title');
  const modalDesc = document.getElementById('modal-desc');
  const modalMedium = document.getElementById('modal-medium');
  const modalYear = document.getElementById('modal-year');
  const modalMaterialsBox = document.getElementById('modal-materials-box');
  const modalMaterials = document.getElementById('modal-materials');
  const closeBtn = document.getElementById('close-modal-btn');
  const closeTopBtn = document.getElementById('close-modal-top');

  function openArtworkModal(card: HTMLElement) {
    if (!modal) return;
    const title = card.dataset.title || '';
    const desc = card.dataset.desc || '';
    const medium = card.dataset.medium || '';
    const year = card.dataset.year || '';
    const img = card.dataset.image || '';
    const materials = card.dataset.materials || '';

    if (modalImage) modalImage.src = img;
    if (modalTitle) modalTitle.textContent = card.querySelector('h2')?.textContent || title;
    if (modalDesc) modalDesc.textContent = card.querySelector('p')?.textContent || desc;
    if (modalMedium) modalMedium.textContent = medium;
    if (modalYear) modalYear.textContent = year;

    if (materials && modalMaterials && modalMaterialsBox) {
      modalMaterials.textContent = materials;
      modalMaterialsBox.classList.remove('hidden');
    } else if (modalMaterialsBox) {
      modalMaterialsBox.classList.add('hidden');
    }

    modal.showModal();
    // Update hash without jumping
    history.replaceState(null, '', `#${card.dataset.id}`);
  }

  cards.forEach((card) => {
    card.addEventListener('click', () => openArtworkModal(card));
  });

  function closeModal() {
    if (modal && modal.open) {
      modal.close();
      history.replaceState(null, '', window.location.pathname);
    }
  }

  closeBtn?.addEventListener('click', closeModal);
  closeTopBtn?.addEventListener('click', closeModal);

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      closeModal();
    }
  });

  // Check URL hash on page load (e.g., from home page /art#vintage-steam-locomotive)
  window.addEventListener('DOMContentLoaded', () => {
    const hash = window.location.hash.replace('#', '');
    if (hash) {
      const targetCard = document.querySelector<HTMLElement>(`[data-id="${hash}"]`);
      if (targetCard) {
        setTimeout(() => openArtworkModal(targetCard), 100);
      }
    }
  });
</script>
