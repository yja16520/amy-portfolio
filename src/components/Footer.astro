---
import profile from '../data/profile.json';
---

<footer class="bg-stone-900 text-stone-300 border-t border-stone-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-20">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 lg:gap-16">
      <!-- Col 1: Bio & Vision -->
      <div class="md:col-span-5 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-amber-600 text-stone-50 flex items-center justify-center font-serif text-lg font-bold">
            Z
          </div>
          <div>
            <h3 class="font-serif text-xl font-bold text-stone-100">Zimeng (Amy) Yan</h3>
            <p class="text-xs uppercase tracking-wider text-stone-400 font-mono">Scholar • Artist • Orator</p>
          </div>
        </div>
        <p class="text-sm leading-relaxed text-stone-400 pt-2 max-w-sm">
          "Science with empathy, art with observation, voice with conviction. Driven by a passion for emergency medicine, neuroscience, and serving communities in need."
        </p>
        <div class="flex items-center gap-4 pt-4">
          {profile.socials.map((social) => (
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-xs font-medium px-3.5 py-1.5 rounded-full bg-stone-800 text-stone-300 hover:bg-amber-600 hover:text-white transition-colors"
            >
              <span>{social.name}</span>
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          ))}
        </div>
      </div>

      <!-- Col 2: Navigation Links -->
      <div class="md:col-span-3 space-y-3">
        <h4 class="text-xs font-mono uppercase tracking-widest text-stone-400 font-semibold">Portfolios</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="/art" class="hover:text-amber-400 transition-colors">Visual Art Studio</a></li>
          <li><a href="/speeches" class="hover:text-amber-400 transition-colors">140+ Speeches Archive</a></li>
          <li><a href="/dance" class="hover:text-amber-400 transition-colors">Baton & Dance Showcase</a></li>
          <li><a href="/experiences" class="hover:text-amber-400 transition-colors">Clinical & Research Experience</a></li>
        </ul>
      </div>

      <!-- Col 3: Maintenance & Architecture Note -->
      <div class="md:col-span-4 space-y-3">
        <h4 class="text-xs font-mono uppercase tracking-widest text-stone-400 font-semibold">Easy Maintenance</h4>
        <p class="text-xs text-stone-400 leading-relaxed">
          Engineered with Astro for effortless long-term updates. Content is decoupled from code into clean JSON data collections in <code class="bg-stone-800 text-amber-300 px-1.5 py-0.5 rounded text-[11px]">src/data/</code>.
        </p>
        <div class="p-3.5 rounded-xl bg-stone-800/60 border border-stone-800 text-xs text-stone-300">
          <span class="text-amber-400 font-medium">To add new content:</span>
          <p class="text-stone-400 mt-1">Add items to <code class="text-stone-200">speeches.json</code> or <code class="text-stone-200">artworks.json</code>. The site updates instantly.</p>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-16 pt-8 border-t border-stone-800/80 flex flex-col sm:flex-row items-center justify-between text-xs text-stone-400 gap-4">
      <p>© {new Date().getFullYear()} Zimeng (Amy) Yan. All rights reserved.</p>

      <!-- Visitor Counter -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-stone-800/90 border border-stone-700/80 text-xs font-mono text-stone-300 shadow-inner">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span class="text-stone-400">VISITOR STATS:</span>
        <img
          src="https://api.visitorbadge.io/api/combined?path=amy-portfolio-ten.vercel.app&label=VIEWS&labelColor=%23292524&countColor=%23d97706&style=flat"
          alt="Live Visitor Counter"
          class="h-4.5 rounded"
          loading="lazy"
        />
      </div>

      <p class="flex items-center gap-1.5">
        Designed for long-term clarity and speed.
      </p>
    </div>
  </div>
</footer>
